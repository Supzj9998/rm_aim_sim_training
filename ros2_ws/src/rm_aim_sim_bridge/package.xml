<?xml version="1.0"?>
<package format="3">
  <name>rm_aim_sim_bridge</name>
  <version>0.1.0</version>
  <description>C++ ROS 2 bridge and session-bound control interface for RoboMaster Aim Lab.</description>
  <maintainer email="maintainers@example.com">RoboMaster Aim Lab maintainers</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>nlohmann-json-dev</depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
